generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Usuario da aplicacao (cada loja tem a sua conta)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  storeName    String
  passwordHash String
  createdAt    DateTime @default(now())

  mlAccount    MlAccount?
  settings     Settings?
  businessRule BusinessRule?
  items        Item[]
}

// Credenciais do app do Mercado Livre + tokens OAuth, por usuario
model MlAccount {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  appId        String?
  appSecret    String?
  redirectUri  String?
  accessToken  String?
  refreshToken String?
  mlUserId     String?
  expiresIn    Int       @default(21600)
  savedAt      DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Configuracoes por usuario
model Settings {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  zipCode   String   @default("01001000")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Regras de negocio por usuario (valores em %)
model BusinessRule {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  icms             Float    @default(0)
  ipi              Float    @default(0)
  difal            Float    @default(0)
  custoOperacional Float    @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Anuncios do Mercado Livre (por usuario)
model Item {
  id            Int      @id @default(autoincrement())
  userId        Int
  mlb           String
  proprio       Boolean  @default(true)
  variacaoIds   String?
  sku           String?
  variacaoSkus  String?
  marca         String?
  titulo        String   @default("")
  thumbnail     String?
  permalink     String?
  custoProduto  Float?
  precoDe       Float    @default(0)
  precoPor      Float    @default(0)
  frete         Float?
  freteAnterior Float?
  freteMudou    Boolean  @default(false)
  comissao      Float?
  comissaoPct   Float?
  status        String?
  dataCriacao   String?
  tipoAnuncio   String?
  visitas       Int      @default(0)
  vendas        Int      @default(0)
  estoque       Int      @default(0)
  catalogo      Boolean  @default(false)
  full          Boolean  @default(false)
  categoria1    String?
  categoria2    String?
  categoria3    String?
  categoria4    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingHistory ShippingHistory[]

  @@unique([userId, mlb])
  @@index([userId])
  @@index([titulo])
  @@index([frete])
}

// Historico de fretes para detectar mudancas ao longo do tempo
model ShippingHistory {
  id         Int      @id @default(autoincrement())
  itemId     Int
  mlb        String
  cost       Float
  capturedAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([mlb])
  @@index([capturedAt])
}
