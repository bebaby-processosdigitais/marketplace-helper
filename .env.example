# Servidor
PORT=3333

# Segredo da sessao (cookie de login) - gere um valor aleatorio proprio
SESSION_SECRET=troque-por-um-valor-aleatorio

# Segredo dos tokens JWT da API (/api). Opcional: se vazio, usa o SESSION_SECRET.
JWT_SECRET=troque-por-um-valor-aleatorio

# Chave de criptografia dos dados sensiveis do ML no banco (32 bytes em hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=troque-por-uma-chave-hex-de-64-caracteres

# Banco (SQLite)
DATABASE_URL="file:./dev.db"

# Ambiente. Em producao (servidor/Railway) use "production": ativa cookie Secure,
# trust proxy e exige SESSION_SECRET/ENCRYPTION_KEY. Localmente, deixe comentado.
# NODE_ENV=production

# Fuso do agendamento da sincronizacao (padrao America/Sao_Paulo)
# TZ=America/Sao_Paulo
