<% var active = 'items'; %>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<%
  // Helpers de ordenacao
  function sortUrl(col) {
    var d = (sort === col && dir === 'asc') ? 'desc' : 'asc';
    var p = '/?sort=' + col + '&dir=' + d;
    if (search) p += '&search=' + encodeURIComponent(search);
    return p;
  }
  function arrow(col) {
    if (sort !== col) return '<span class="sort-ico">↕</span>';
    return dir === 'asc' ? '<span class="sort-ico active">▲</span>' : '<span class="sort-ico active">▼</span>';
  }
%>

<div class="container-fluid py-3 px-md-4">

  <!-- Barra de acoes -->
  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <form class="d-flex flex-grow-1" method="get" action="/" role="search">
      <input type="hidden" name="sort" value="<%= sort %>" />
      <input type="hidden" name="dir" value="<%= dir %>" />
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input
          type="text" name="search" class="form-control"
          placeholder="Buscar por MLB, título ou SKU..."
          value="<%= search %>"
        />
        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        <% if (search) { %>
          <a href="/" class="btn btn-outline-danger" title="Limpar"><i class="bi bi-x-lg"></i></a>
        <% } %>
      </div>
    </form>

    <!-- Botao que aparece quando ha itens selecionados -->
    <button id="btnSyncSel" class="btn btn-primary fw-semibold d-none">
      <i class="bi bi-check2-square"></i> Atualizar seleção (<span id="selCount">0</span>)
    </button>

    <button id="btnSync" class="btn btn-outline-primary fw-semibold" <%= authenticated ? '' : 'disabled' %>>
      <i class="bi bi-arrow-repeat"></i> Atualizar tudo
    </button>

    <a
      class="btn btn-success"
      href="/export<%= search ? ('?search=' + encodeURIComponent(search)) : '' %>"
    >
      <i class="bi bi-file-earmark-excel"></i> Exportar Excel
    </a>

    <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#cepModal">
      <i class="bi bi-geo-alt"></i> CEP: <%= zipCode %>
    </button>
  </div>

  <!-- Progresso do sync -->
  <div id="syncBox" class="alert alert-info d-none">
    <div class="d-flex justify-content-between">
      <span id="syncPhase">Iniciando...</span>
      <span id="syncCounts"></span>
    </div>
    <div class="progress mt-2" style="height: 8px;">
      <div id="syncBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
    </div>
  </div>

  <% if (!authenticated) { %>
    <div class="alert alert-warning">
      <i class="bi bi-exclamation-triangle"></i>
      Você ainda não autorizou o app. Vá em <a href="/auth" class="alert-link">Autorização</a> para conectar.
    </div>
  <% } %>

  <!-- Info -->
  <div class="d-flex justify-content-between align-items-center mb-2">
    <small class="text-muted">
      <strong><%= total %></strong> anúncio(s)
      <% if (search) { %> para "<strong><%= search %></strong>"<% } %>
      · página <%= page %> de <%= totalPages %>
    </small>
  </div>

  <!-- Tabela -->
  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover table-sm align-middle bg-white mb-0">
      <thead>
        <tr>
          <th class="text-center" style="width: 34px;">
            <input class="form-check-input" type="checkbox" id="checkAll" title="Selecionar todos" />
          </th>
          <th><a class="sort-link" href="<%= sortUrl('mlb') %>">MLB <%- arrow('mlb') %></a></th>
          <th><a class="sort-link" href="<%= sortUrl('titulo') %>">Título <%- arrow('titulo') %></a></th>
          <th><a class="sort-link" href="<%= sortUrl('sku') %>">SKU <%- arrow('sku') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('custoProduto') %>">Custo <%- arrow('custoProduto') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('precoDe') %>">Preço De <%- arrow('precoDe') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('precoPor') %>">Preço Por <%- arrow('precoPor') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('frete') %>">Frete <%- arrow('frete') %></a></th>
          <th class="text-center">Frete Δ</th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('comissao') %>">Comissão <%- arrow('comissao') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('custoML') %>">Custo ML <%- arrow('custoML') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('lucro') %>">Lucro Líq. <%- arrow('lucro') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('margem') %>">Margem <%- arrow('margem') %></a></th>
          <th class="text-center"><a class="sort-link" href="<%= sortUrl('tipo') %>">Tipo <%- arrow('tipo') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('visitas') %>">Visitas <%- arrow('visitas') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('vendas') %>">Vendas <%- arrow('vendas') %></a></th>
          <th class="text-end"><a class="sort-link" href="<%= sortUrl('estoque') %>">Estoque <%- arrow('estoque') %></a></th>
          <th class="text-center"><a class="sort-link" href="<%= sortUrl('full') %>">Full <%- arrow('full') %></a></th>
          <th class="text-center"><a class="sort-link" href="<%= sortUrl('status') %>">Status <%- arrow('status') %></a></th>
        </tr>
      </thead>
      <tbody>
        <% if (items.length === 0) { %>
          <tr><td colspan="19" class="text-center text-muted py-4">
            Nenhum anúncio. Clique em <strong>Atualizar tudo</strong> para sincronizar com o Mercado Livre.
          </td></tr>
        <% } %>
        <% items.forEach(function(it) { %>
          <tr>
            <td class="text-center">
              <input class="form-check-input row-check" type="checkbox" value="<%= it.mlb %>" />
            </td>
            <td>
              <a href="https://www.mercadolivre.com.br/anuncio/<%= it.mlb %>" target="_blank" class="text-decoration-none">
                <%= it.mlb %>
              </a>
            </td>
            <td class="text-truncate" style="max-width: 320px;" title="<%= it.titulo %>"><%= it.titulo %></td>
            <td><small><%= it.sku || '-' %></small></td>
            <td class="text-end" style="min-width: 110px;">
              <div class="input-group input-group-sm custo-group">
                <span class="input-group-text">R$</span>
                <input type="text" inputmode="decimal" class="form-control custo-input text-end"
                       data-mlb="<%= it.mlb %>"
                       value="<%= it.custoProduto != null ? it.custoProduto.toFixed(2) : '' %>"
                       placeholder="0,00" />
              </div>
            </td>
            <td class="text-end">R$ <%= it.precoDe.toFixed(2) %></td>
            <td class="text-end"><%= it.precoPor ? 'R$ ' + it.precoPor.toFixed(2) : '-' %></td>
            <td class="text-end"><%= it.frete != null ? 'R$ ' + it.frete.toFixed(2) : '-' %></td>
            <td class="text-center">
              <% if (it.freteMudou && it.freteAnterior != null) { %>
                <% var up = it.frete > it.freteAnterior; %>
                <span class="badge <%= up ? 'text-bg-danger' : 'text-bg-success' %>" title="Antes: R$ <%= it.freteAnterior.toFixed(2) %>">
                  <i class="bi bi-arrow-<%= up ? 'up' : 'down' %>"></i>
                  R$ <%= Math.abs(it.frete - it.freteAnterior).toFixed(2) %>
                </span>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td class="text-end">
              <% if (it.comissao != null) { %>
                R$ <%= it.comissao.toFixed(2) %>
                <% if (it.comissaoPct != null) { %><small class="text-muted">(<%= it.comissaoPct %>%)</small><% } %>
              <% } else { %>-<% } %>
            </td>
            <td class="text-end">
              <% if (it.comissao != null) { %>
                <strong class="text-danger">R$ <%= it._calc.custoML.toFixed(2) %></strong>
              <% } else { %>-<% } %>
            </td>
            <td class="text-end cell-lucro" data-mlb="<%= it.mlb %>">
              <% if (it._calc.lucro != null) { %>
                <strong class="<%= it._calc.lucro >= 0 ? 'text-success' : 'text-danger' %>">R$ <%= it._calc.lucro.toFixed(2) %></strong>
              <% } else { %><span class="text-muted">-</span><% } %>
            </td>
            <td class="text-end cell-margem" data-mlb="<%= it.mlb %>">
              <% if (it._calc.margem != null) { %>
                <span class="badge <%= it._calc.margem >= 0 ? 'text-bg-success' : 'text-bg-danger' %>"><%= it._calc.margem.toFixed(1) %>%</span>
              <% } else { %><span class="text-muted">-</span><% } %>
            </td>
            <td class="text-center"><small><%= it.tipoAnuncio %></small></td>
            <td class="text-end"><%= it.visitas %></td>
            <td class="text-end"><%= it.vendas %></td>
            <td class="text-end"><%= it.estoque %></td>
            <td class="text-center"><% if (it.full) { %><i class="bi bi-check-circle-fill" style="color: var(--mh-primary)"></i><% } %></td>
            <td class="text-center">
              <span class="badge <%= it.status === 'active' ? 'text-bg-success' : 'text-bg-secondary' %>">
                <%= it.status || '-' %>
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Paginacao -->
  <% if (totalPages > 1) { %>
    <%
      function pageUrl(p) {
        var u = '/?page=' + p;
        if (search) u += '&search=' + encodeURIComponent(search);
        if (sort) u += '&sort=' + sort + '&dir=' + dir;
        return u;
      }
    %>
    <nav class="mt-3">
      <ul class="pagination justify-content-center flex-wrap">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="<%= pageUrl(page - 1) %>">Anterior</a>
        </li>
        <%
          var start = Math.max(1, page - 3);
          var end = Math.min(totalPages, page + 3);
          if (start > 1) { %>
            <li class="page-item"><a class="page-link" href="<%= pageUrl(1) %>">1</a></li>
            <% if (start > 2) { %><li class="page-item disabled"><span class="page-link">…</span></li><% }
          }
          for (var p = start; p <= end; p++) { %>
            <li class="page-item <%= p === page ? 'active' : '' %>">
              <a class="page-link" href="<%= pageUrl(p) %>"><%= p %></a>
            </li>
          <% }
          if (end < totalPages) {
            if (end < totalPages - 1) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %>
            <li class="page-item"><a class="page-link" href="<%= pageUrl(totalPages) %>"><%= totalPages %></a></li>
          <% } %>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="<%= pageUrl(page + 1) %>">Próxima</a>
        </li>
      </ul>
    </nav>
  <% } %>
</div>

<!-- Modal CEP -->
<div class="modal fade" id="cepModal" tabindex="-1">
  <div class="modal-dialog">
    <form class="modal-content" action="/settings/zip" method="post">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-geo-alt"></i> CEP para cálculo de frete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">CEP de destino (somente números)</label>
        <input type="text" name="zipCode" class="form-control" value="<%= zipCode %>" placeholder="01001000" />
        <small class="text-muted">Usado ao calcular o frete no próximo <strong>Atualizar</strong>.</small>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
