<%- include('partials/head') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h3 class="mb-1"><i class="bi bi-box-seam text-primary"></i> Marketplace Helper</h3>
      <p class="text-muted mb-0">Recuperar senha</p>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <% if (sent) { %>
          <div class="alert alert-info">
            <i class="bi bi-envelope"></i>
            Se houver uma conta com <strong><%= email %></strong>, enviaremos instruções de
            recuperação por e-mail.
          </div>
          <div class="alert alert-warning py-2 small mb-3">
            <i class="bi bi-cone-striped"></i>
            <strong>Em construção:</strong> o envio de e-mail ainda não está configurado.
            Por enquanto, peça ao administrador para redefinir sua senha.
          </div>
          <a href="/login" class="btn btn-primary w-100"><i class="bi bi-arrow-left"></i> Voltar ao login</a>
        <% } else { %>
          <p class="text-muted">
            Informe o e-mail da sua conta e enviaremos um link para redefinir a senha.
          </p>
          <form method="post" action="/recuperar-senha">
            <div class="mb-3">
              <label class="form-label">E-mail</label>
              <input type="email" name="email" class="form-control" required autofocus />
            </div>
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-envelope"></i> Enviar instruções
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <p class="text-center text-muted mt-3 mb-0"><a href="/login">Voltar ao login</a></p>
  </div>
</div>

<%- include('partials/footer') %>
