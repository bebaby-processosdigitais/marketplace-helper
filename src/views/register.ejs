<%- include('partials/head') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h3 class="mb-1"><i class="bi bi-box-seam text-primary"></i> Marketplace Helper</h3>
      <p class="text-muted mb-0">Crie sua conta</p>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <% if (error) { %>
          <div class="alert alert-danger py-2"><i class="bi bi-x-circle"></i> <%= error %></div>
        <% } %>

        <form method="post" action="/register">
          <div class="mb-3">
            <label class="form-label">Nome da loja</label>
            <input type="text" name="storeName" class="form-control" value="<%= values.storeName || '' %>" required autofocus />
          </div>
          <div class="mb-3">
            <label class="form-label">E-mail</label>
            <input type="email" name="email" class="form-control" value="<%= values.email || '' %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Senha</label>
            <input type="password" name="password" class="form-control" required />
            <small class="text-muted">Mínimo 8 caracteres, com pelo menos 1 letra maiúscula e 1 número.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Confirmar senha</label>
            <input type="password" name="confirmPassword" class="form-control" required />
          </div>
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-person-plus"></i> Criar conta
          </button>
        </form>
      </div>
    </div>

    <p class="text-center text-muted mt-3 mb-0">
      Já tem conta? <a href="/login">Entrar</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
