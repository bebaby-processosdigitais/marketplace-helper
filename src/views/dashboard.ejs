<% var active = 'dashboard'; %>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container-fluid py-3 px-md-4">
  <h3 class="mb-3"><i class="bi bi-speedometer2"></i> Dashboard</h3>

  <%
    // KPI clicável (leva à lista filtrada) com badge de ícone colorido.
    function kpiLink(href, label, value, valueClass, sub, icon, color) {
      return '<div class="col"><a href="' + href + '" class="card kpi kpi-link shadow-sm h-100 text-decoration-none">'
        + '<div class="card-body d-flex align-items-start gap-2">'
        + '<div class="kpi-icon text-bg-' + color + '"><i class="bi bi-' + icon + '"></i></div>'
        + '<div class="kpi-text flex-grow-1">'
        + '<div class="kpi-label">' + label + '</div>'
        + '<div class="kpi-value ' + (valueClass || '') + '">' + value + '</div>'
        + '<small class="text-muted">' + sub + '</small>'
        + '</div>'
        + '<span class="kpi-go"><i class="bi bi-arrow-right-circle"></i></span>'
        + '</div></a></div>';
    }
    // KPI de valor (não clicável) com badge de ícone colorido.
    function kpiValue(label, value, valueClass, sub, icon, color) {
      return '<div class="col"><div class="card kpi shadow-sm h-100">'
        + '<div class="card-body d-flex align-items-start gap-2">'
        + '<div class="kpi-icon text-bg-' + color + '"><i class="bi bi-' + icon + '"></i></div>'
        + '<div class="kpi-text flex-grow-1">'
        + '<div class="kpi-label">' + label + '</div>'
        + '<div class="kpi-value ' + (valueClass || '') + '">' + value + '</div>'
        + '<small class="text-muted">' + sub + '</small>'
        + '</div>'
        + '</div></div></div>';
    }
    var comCustoSub = countMargem + ' com custo';
  %>

  <!-- Desempenho (clicáveis -> abrem a lista filtrada) -->
  <div class="kpi-group-label"><i class="bi bi-graph-up"></i> Desempenho</div>
  <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    <%- kpiLink('/anuncios?filter=prejuizo', 'No prejuízo', prejuizo, prejuizo > 0 ? 'text-danger' : '', comCustoSub, 'graph-down-arrow', 'danger') %>
    <%- kpiLink('/anuncios?filter=baixo', 'Baixo desempenho', baixoDesempenho, baixoDesempenho > 0 ? 'text-warning' : '', 'margem 0–8% · ' + comCustoSub, 'exclamation-triangle', 'warning') %>
    <%- kpiLink('/anuncios?filter=alto', 'Alto desempenho', altoDesempenho, altoDesempenho > 0 ? 'text-success' : '', 'margem ≥ 8% · ' + comCustoSub, 'graph-up-arrow', 'success') %>
    <%- kpiLink('/anuncios?filter=catalogo', 'No catálogo', catalogo, catalogo > 0 ? 'text-primary' : '', 'anúncios de catálogo', 'trophy', 'primary') %>
  </div>

  <!-- Estoque & cadastro -->
  <div class="kpi-group-label"><i class="bi bi-box-seam"></i> Estoque &amp; cadastro</div>
  <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    <%- kpiLink('/anuncios?filter=estoque_baixo', 'Estoque baixo', estoqueBaixo, estoqueBaixo > 0 ? 'text-danger' : '', '≤ 5 unidades · ativos', 'box-seam', 'danger') %>
    <%- kpiLink('/anuncios?filter=full_estoque_baixo', 'Full · estoque baixo', fullEstoqueBaixo, fullEstoqueBaixo > 0 ? 'text-danger' : '', '≤ 5 no Full · ativos', 'lightning-charge-fill', 'warning') %>
    <%- kpiLink('/anuncios?filter=sem_custo', 'Sem custo', semCustoAtivos, semCustoAtivos > 0 ? 'text-secondary' : '', 'preencher para ver margem', 'tag', 'secondary') %>
    <%- kpiValue('Ticket médio', 'R$ ' + ticketMedio.toFixed(2), '', 'preço de venda · ativos', 'cash-coin', 'primary') %>
  </div>

  <!-- Saúde financeira (valores) -->
  <div class="kpi-group-label"><i class="bi bi-wallet2"></i> Saúde financeira</div>
  <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    <%- kpiValue('Custo médio do ML', custoMLMedioPct != null ? custoMLMedioPct.toFixed(1) + '%' : '—', '', 'comissão + frete / preço', 'percent', 'primary') %>
    <%- kpiValue('Lucro líquido médio', lucroMedio != null ? 'R$ ' + lucroMedio.toFixed(2) : '—', lucroMedio != null ? (lucroMedio >= 0 ? 'text-success' : 'text-danger') : '', 'por anúncio · ' + comCustoSub, 'coin', 'success') %>
    <%- kpiValue('Margem média', margemMedia != null ? margemMedia.toFixed(1) + '%' : '—', '', comCustoSub, 'graph-up-arrow', 'primary') %>
    <%- kpiValue('Com custo preenchido', comCusto + ' <small class="text-muted fs-6">de ' + total + '</small>', '', 'cobertura de custo', 'check2-circle', 'success') %>
  </div>

  <!-- Insights inteligentes -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">
      <i class="bi bi-lightbulb text-warning"></i> Insights inteligentes
    </div>
    <div class="card-body">
      <% if (insights && insights.length) { %>
        <div class="row g-3">
          <% insights.forEach(function(ins) { %>
            <div class="col-12 col-lg-6">
              <a href="<%= ins.link %>" class="text-decoration-none">
                <div class="d-flex gap-3 p-2 rounded insight-item">
                  <div class="insight-icon text-bg-<%= ins.color %>">
                    <i class="bi bi-<%= ins.icon %>"></i>
                  </div>
                  <div>
                    <div class="fw-semibold text-dark"><%= ins.titulo %></div>
                    <div class="text-muted small"><%= ins.texto %></div>
                  </div>
                </div>
              </a>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center text-muted py-3">
          <i class="bi bi-check-circle text-success fs-4 d-block mb-2"></i>
          Tudo certo por aqui! Nenhum ponto de atenção no momento.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Últimos anúncios cadastrados -->
  <%
    function mlUrl(it) {
      if (it.permalink) return it.permalink;
      var digits = String(it.mlb).replace(/\D/g, '');
      return 'https://produto.mercadolivre.com.br/MLB-' + digits;
    }
  %>
  <% if (ultimosAnuncios && ultimosAnuncios.length) { %>
    <h5 class="mb-3"><i class="bi bi-clock-history"></i> Últimos anúncios cadastrados</h5>
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
      <% ultimosAnuncios.forEach(function(it) { %>
        <div class="col">
          <div class="card h-100 shadow-sm overflow-hidden">
            <a href="<%= mlUrl(it) %>" target="_blank" rel="noopener" class="ultimo-img">
              <% if (it.thumbnail) { %>
                <img src="<%= it.thumbnail %>" alt="<%= it.titulo %>" loading="lazy" />
              <% } else { %>
                <div class="ultimo-img-placeholder"><i class="bi bi-image"></i></div>
              <% } %>
            </a>
            <div class="card-body p-2 d-flex flex-column">
              <div class="small fw-semibold ultimo-titulo mb-1" title="<%= it.titulo %>"><%= it.titulo %></div>
              <div class="text-muted" style="font-size: 0.72rem;"><%= it.mlb %></div>

              <div class="mt-2 d-flex justify-content-between align-items-baseline">
                <span class="text-muted" style="font-size: 0.72rem;">Venda</span>
                <span class="fw-semibold">R$ <%= it._calc.base.toFixed(2) %></span>
              </div>
              <div class="d-flex justify-content-between align-items-baseline">
                <span class="text-muted" style="font-size: 0.72rem;">Lucro</span>
                <% if (it._calc.lucro != null) { %>
                  <span class="fw-semibold <%= it._calc.lucro >= 0 ? 'text-success' : 'text-danger' %>">R$ <%= it._calc.lucro.toFixed(2) %></span>
                <% } else { %><span class="text-muted">-</span><% } %>
              </div>

              <div class="mt-2 d-flex justify-content-between align-items-center">
                <% if (it._calc.margem != null) { %>
                  <span class="badge <%= it._calc.margem >= 0 ? 'text-bg-success' : 'text-bg-danger' %>">
                    <%= it._calc.margem.toFixed(1) %>%
                  </span>
                <% } else { %><span></span><% } %>
                <span class="badge text-bg-<%= it._health.color %>" title="Saúde do anúncio">
                  <i class="bi bi-<%= it._health.icon %>"></i> <%= it._health.label %>
                </span>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <div class="row g-3">
    <!-- Fretes mais caros -->
    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-header fw-semibold bg-white">
          <i class="bi bi-fire text-danger"></i> Fretes mais caros (Top 10)
        </div>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr><th>MLB</th><th>Título</th><th class="text-end">Frete</th></tr>
            </thead>
            <tbody>
              <% if (fretesMaisCaros.length === 0) { %>
                <tr><td colspan="3" class="text-center text-muted py-3">Sem dados. Rode um Atualizar.</td></tr>
              <% } %>
              <% fretesMaisCaros.forEach(function(it) { %>
                <tr>
                  <td><small><%= it.mlb %></small></td>
                  <td class="text-truncate" style="max-width: 260px;" title="<%= it.titulo %>"><%= it.titulo %></td>
                  <td class="text-end fw-semibold text-danger">R$ <%= it.frete.toFixed(2) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Fretes que mudaram -->
    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-header fw-semibold bg-white d-flex justify-content-between align-items-center">
          <span><i class="bi bi-arrow-left-right text-primary"></i> Fretes que mudaram</span>
          <% if (fretesMudaram.length) { %>
            <span class="badge <%= deltaTotal > 0 ? 'text-bg-danger' : 'text-bg-success' %>">
              Δ total: R$ <%= deltaTotal.toFixed(2) %>
            </span>
          <% } %>
        </div>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr><th>MLB</th><th>Título</th><th class="text-end">Antes</th><th class="text-end">Agora</th><th class="text-end">Δ</th></tr>
            </thead>
            <tbody>
              <% if (fretesMudaram.length === 0) { %>
                <tr><td colspan="5" class="text-center text-muted py-3">Nenhuma mudança detectada no último sync.</td></tr>
              <% } %>
              <% fretesMudaram.forEach(function(it) { %>
                <% var up = it.frete > it.freteAnterior; %>
                <tr>
                  <td><small><%= it.mlb %></small></td>
                  <td class="text-truncate" style="max-width: 200px;" title="<%= it.titulo %>"><%= it.titulo %></td>
                  <td class="text-end text-muted">R$ <%= it.freteAnterior.toFixed(2) %></td>
                  <td class="text-end fw-semibold">R$ <%= it.frete.toFixed(2) %></td>
                  <td class="text-end">
                    <span class="badge <%= up ? 'text-bg-danger' : 'text-bg-success' %>">
                      <i class="bi bi-arrow-<%= up ? 'up' : 'down' %>"></i>
                      <%= Math.abs(it.frete - it.freteAnterior).toFixed(2) %>
                    </span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Distribuicao por tipo + totais -->
    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-header fw-semibold bg-white"><i class="bi bi-pie-chart"></i> Por tipo de anúncio</div>
        <ul class="list-group list-group-flush">
          <% porTipo.forEach(function(t) { %>
            <li class="list-group-item d-flex justify-content-between">
              <span><%= t.tipo %></span><span class="badge text-bg-primary rounded-pill"><%= t.count %></span>
            </li>
          <% }); %>
          <li class="list-group-item d-flex justify-content-between bg-light">
            <span><i class="bi bi-lightning-charge-fill text-success"></i> No Full</span>
            <span class="badge text-bg-success rounded-pill"><%= full %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between bg-light">
            <span><i class="bi bi-stars text-primary"></i> No Catálogo</span>
            <span class="badge text-bg-primary rounded-pill"><%= catalogo %></span>
          </li>
        </ul>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-header fw-semibold bg-white"><i class="bi bi-bar-chart-line"></i> Totais</div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between"><span>Estoque total</span><strong><%= estoqueTotal %></strong></li>
          <li class="list-group-item d-flex justify-content-between"><span>Vendas totais</span><strong><%= vendasTotal %></strong></li>
          <li class="list-group-item d-flex justify-content-between"><span>Visitas totais</span><strong><%= visitasTotal %></strong></li>
          <li class="list-group-item d-flex justify-content-between"><span>Frete mínimo</span><strong>R$ <%= freteMin.toFixed(2) %></strong></li>
          <li class="list-group-item d-flex justify-content-between"><span>Soma dos fretes</span><strong>R$ <%= freteSoma.toFixed(2) %></strong></li>
        </ul>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
