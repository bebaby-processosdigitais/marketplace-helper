<% var active = 'rules'; %>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container py-4" style="max-width: 720px;">
  <h3 class="mb-1"><i class="bi bi-sliders"></i> Regras de Negócio</h3>
  <p class="text-muted mb-4">
    Impostos e custos usados nos cálculos. Os valores são em <strong>porcentagem (%)</strong>.
  </p>

  <% if (message) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> <%= message %></div>
  <% } %>

  <form action="/regras" method="post">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="row g-4">
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">ICMS</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" name="icms" class="form-control"
                     value="<%= rules.icms %>" placeholder="0,00" />
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Alíquota de ICMS da venda.</small>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">IPI</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" name="ipi" class="form-control"
                     value="<%= rules.ipi %>" placeholder="0,00" />
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Imposto sobre Produtos Industrializados.</small>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">DIFAL</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" name="difal" class="form-control"
                     value="<%= rules.difal %>" placeholder="0,00" />
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Diferencial de alíquota interestadual.</small>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Custo Operacional</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" name="custoOperacional" class="form-control"
                     value="<%= rules.custoOperacional %>" placeholder="0,00" />
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Custo operacional sobre a venda.</small>
          </div>
        </div>
      </div>
      <div class="card-footer bg-white d-flex justify-content-between align-items-center">
        <small class="text-muted">
          Última atualização: <%= new Date(rules.updatedAt).toLocaleString('pt-BR') %>
        </small>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-save"></i> Salvar regras
        </button>
      </div>
    </div>
  </form>

  <p class="text-muted mt-3 small">
    <i class="bi bi-info-circle"></i>
    Por enquanto esses valores só ficam salvos. Em breve serão usados nos cálculos de margem/custo.
  </p>
</div>

<%- include('partials/footer') %>
