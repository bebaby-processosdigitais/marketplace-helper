<%- include('partials/head') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h3 class="mb-1"><i class="bi bi-box-seam text-primary"></i> Marketplace Helper</h3>
      <p class="text-muted mb-0">Entre na sua conta</p>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <% if (message) { %>
          <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> <%= message %></div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger py-2"><i class="bi bi-x-circle"></i> <%= error %></div>
        <% } %>

        <form method="post" action="/login">
          <div class="mb-3">
            <label class="form-label">E-mail</label>
            <input type="email" name="email" class="form-control" required autofocus />
          </div>
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <label class="form-label mb-0">Senha</label>
              <a href="/recuperar-senha" class="small">Esqueceu a senha?</a>
            </div>
            <input type="password" name="password" class="form-control mt-1" required />
          </div>
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-box-arrow-in-right"></i> Entrar
          </button>
        </form>
      </div>
    </div>

    <p class="text-center text-muted mt-3 mb-0">
      Não tem conta? <a href="/register">Criar conta</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
