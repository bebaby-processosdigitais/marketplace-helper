<% active = 'estoque-full'; %>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container-fluid py-3 px-md-4">
  <h3 class="mb-1"><i class="bi bi-boxes"></i> Estoque Full/Cross/Carreta</h3>
  <p class="text-muted mb-3" style="max-width: 820px;">
    Suba a planilha de estoque do ERP (Sankhya) e cruzamos por <strong>SKU</strong> com os seus anúncios.
    O objetivo é checar diariamente o <strong>estoque 103 (SITE MATRIZ)</strong>, que reflete o marketplace:
    identificar itens <strong>não cadastrados</strong>, itens com <strong>pouco estoque no 103</strong> que existem
    em outros locais (mover para o 103 ou trazer da Filial Sul por carreta) e o que pode ir para o Full.
  </p>

  <% if (erro) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= erro %></div>
  <% } %>
  <% if (ok) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> <%= ok %></div>
  <% } %>

  <!-- Upload (sempre disponível) -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">
      <i class="bi bi-upload"></i> <%= upload ? 'Enviar outra planilha' : 'Enviar planilha de estoque' %>
    </div>
    <div class="card-body">
      <form method="post" action="/telas/estoque-full/upload" enctype="multipart/form-data"
            class="row g-2 align-items-center">
        <div class="col-12 col-md-7">
          <input type="file" name="planilha" accept=".xls,.xlsx" required
                 class="form-control" />
          <div class="form-text">Export de estoque do Sankhya (.xls ou .xlsx), com as colunas Código, Produto, Estoque, Cód Local e Local.</div>
        </div>
        <div class="col-12 col-md-auto">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-gear"></i> Processar planilha
          </button>
        </div>
      </form>
    </div>
  </div>

  <% if (!cross) { %>
    <div class="text-center text-muted py-4">
      <i class="bi bi-arrow-up-circle fs-1 d-block mb-2 text-primary"></i>
      Envie uma planilha acima para gerar o relatório cruzado.
    </div>
  <% } else { %>

  <%
    function dtBR(iso) { try { return new Date(iso).toLocaleString('pt-BR', { dateStyle:'short', timeStyle:'short' }); } catch(e){ return '—'; } }
    // KPI clicável: filtra a tabela dinâmica abaixo (via data-filter + estoque.js).
    function kpiFilter(filter, label, value, valueClass, sub, icon, color) {
      return '<div class="col"><div class="card kpi estoque-kpi shadow-sm h-100" role="button" tabindex="0" data-filter="' + filter + '">'
        + '<div class="card-body d-flex align-items-start gap-2">'
        + '<div class="kpi-icon text-bg-' + color + '"><i class="bi bi-' + icon + '"></i></div>'
        + '<div class="kpi-text flex-grow-1"><div class="kpi-label">' + label + '</div>'
        + '<div class="kpi-value ' + (valueClass||'') + '">' + value + '</div>'
        + '<small class="text-muted">' + sub + '</small></div>'
        + '</div></div></div>';
    }
  %>

  <!-- Meta + ações -->
  <div class="card shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-3 justify-content-between">
      <div class="small text-muted">
        <i class="bi bi-file-earmark-spreadsheet text-success"></i>
        <strong class="text-dark"><%= upload.originalName %></strong>
        · <%= upload.totalSkus %> SKU(s) · <%= upload.totalLinhas %> linha(s)
        <% if (upload.emissao) { %> · emissão ERP: <%= upload.emissao %><% } %>
        · enviada em <%= dtBR(upload.uploadedAt) %>
      </div>
      <div class="d-flex gap-2">
        <a href="/telas/estoque-full/relatorio" class="btn btn-success">
          <i class="bi bi-file-earmark-excel"></i> Baixar relatório Excel
        </a>
        <form method="post" action="/telas/estoque-full/limpar"
              onsubmit="return confirm('Apagar os dados da planilha enviada? O relatório deixará de estar disponível até você subir outra.');">
          <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Apagar dados
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- KPIs clicáveis: filtram a tabela abaixo -->
  <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-3">
    <%- kpiFilter('all', 'Todos', cross.rows.length, '', 'linhas no cruzamento', 'list-ul', 'primary') %>
    <%- kpiFilter('nao_cadastrado', 'Não cadastrados', cross.stats.naoCadastrados, cross.stats.naoCadastrados>0?'text-dark':'', 'com estoque, sem anúncio', 'plus-square', 'dark') %>
    <%- kpiFilter('baixo103', '103 baixo', cross.stats.baixo103, cross.stats.baixo103>0?'text-danger':'', '≤ ' + cross.limiar103 + ' no SITE MATRIZ', 'box-seam', 'danger') %>
    <%- kpiFilter('baixo103alt', '103 baixo c/ alternativa', cross.stats.baixo103ComAlternativa, cross.stats.baixo103ComAlternativa>0?'text-warning':'', 'há estoque em outro local', 'truck', 'warning') %>
    <%- kpiFilter('sem_estoque', 'Sem estoque', cross.stats.semEstoque, '', 'cadastrados, zero em tudo', 'x-circle', 'secondary') %>
  </div>

  <!-- Tabela dinâmica: ordenar clicando nos títulos, buscar e paginar -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex flex-wrap gap-2 align-items-center justify-content-between">
      <span class="fw-semibold"><i class="bi bi-table"></i> Planilha cruzada</span>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span id="estoque-info" class="small text-muted"></span>
        <div class="input-group input-group-sm" style="width: 230px;">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input id="estoque-search" type="search" class="form-control" placeholder="SKU, título ou MLB" autocomplete="off" />
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th data-key="sku">SKU <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <th data-key="titulo">Produto / Título <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <th class="text-center" data-key="temCatalogo">Cat? <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <th class="text-center" data-key="estaNoFull">Full? <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <th class="text-end" data-key="estoque">Est. ML <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <th class="text-end" data-key="estoqueFull">Est. Full <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <th data-key="status">Status <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <th class="text-center" data-key="cadastrado">No ML? <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <% cross.locais.forEach(function(l){ %>
              <th class="text-end <%= l.marketplace ? 'table-warning' : '' %>" data-key="est<%= l.cod %>" title="<%= l.cod %> - <%= l.nome %>"><%= l.cod %> <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
            <% }); %>
            <th data-key="sugestao">Sugestão <i class="sort-ind bi bi-chevron-expand text-muted"></i></th>
          </tr>
        </thead>
        <tbody id="estoque-tbody"></tbody>
      </table>
    </div>
    <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div class="text-muted small">
        <span class="badge table-warning text-dark border">103</span> = SITE MATRIZ (marketplace) · Estoque Full = <%= cross.fullNome %> · clique nos títulos para ordenar (A–Z / Z–A).
      </div>
      <nav><ul id="estoque-pager" class="pagination pagination-sm mb-0"></ul></nav>
    </div>
  </div>

  <script id="estoque-data" type="application/json"><%- JSON.stringify({ limiar: cross.limiar103, locais: cross.locais.map(function(l){ return { cod: l.cod, nome: l.nome, marketplace: !!l.marketplace }; }), rows: cross.rows }).replace(/</g, '\\u003c') %></script>
  <script src="/js/estoque.js"></script>

  <% } %>
</div>

<%- include('partials/footer') %>
