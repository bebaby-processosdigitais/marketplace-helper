<% active = 'estoque-full'; %>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container-fluid py-3 px-md-4">
  <h3 class="mb-1"><i class="bi bi-boxes"></i> Estoque Full/Cross/Carreta</h3>
  <p class="text-muted mb-3" style="max-width: 820px;">
    Suba a planilha de estoque do ERP (Sankhya) e cruzamos por <strong>SKU</strong> com os seus anúncios.
    O objetivo é checar diariamente o <strong>estoque 103 (SITE MATRIZ)</strong>, que reflete o marketplace:
    identificar itens <strong>não cadastrados</strong>, itens com <strong>pouco estoque no 103</strong> que existem
    em outros locais (mover para o 103 ou trazer da Filial Sul por carreta) e o que pode ir para o Full.
  </p>

  <% if (erro) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= erro %></div>
  <% } %>
  <% if (ok) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> <%= ok %></div>
  <% } %>

  <!-- Upload (sempre disponível) -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">
      <i class="bi bi-upload"></i> <%= upload ? 'Enviar outra planilha' : 'Enviar planilha de estoque' %>
    </div>
    <div class="card-body">
      <form method="post" action="/telas/estoque-full/upload" enctype="multipart/form-data"
            class="row g-2 align-items-center">
        <div class="col-12 col-md-7">
          <input type="file" name="planilha" accept=".xls,.xlsx" required
                 class="form-control" />
          <div class="form-text">Export de estoque do Sankhya (.xls ou .xlsx), com as colunas Código, Produto, Estoque, Cód Local e Local.</div>
        </div>
        <div class="col-12 col-md-auto">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-gear"></i> Processar planilha
          </button>
        </div>
      </form>
    </div>
  </div>

  <% if (!cross) { %>
    <div class="text-center text-muted py-4">
      <i class="bi bi-arrow-up-circle fs-1 d-block mb-2 text-primary"></i>
      Envie uma planilha acima para gerar o relatório cruzado.
    </div>
  <% } else { %>

  <%
    function dtBR(iso) { try { return new Date(iso).toLocaleString('pt-BR', { dateStyle:'short', timeStyle:'short' }); } catch(e){ return '—'; } }
    function boolBadge(v) {
      if (v == null) return '<span class="text-muted">—</span>';
      return v ? '<span class="badge text-bg-success">Sim</span>' : '<span class="badge text-bg-light text-muted">Não</span>';
    }
    function sugBadge(s) {
      if (!s) return '';
      var cor = 'secondary';
      if (s.indexOf('Cadastrar') === 0) cor = 'dark';
      else if (s.indexOf('Mover') === 0) cor = 'primary';
      else if (s.indexOf('Carreta') === 0) cor = 'warning';
      else if (s.indexOf('Full') >= 0) cor = 'success';
      else if (s.indexOf('Sem estoque') === 0) cor = 'danger';
      return '<span class="badge text-bg-' + cor + '">' + s + '</span>';
    }
    var PREVIEW = 80;
  %>

  <!-- Meta + ações -->
  <div class="card shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-3 justify-content-between">
      <div class="small text-muted">
        <i class="bi bi-file-earmark-spreadsheet text-success"></i>
        <strong class="text-dark"><%= upload.originalName %></strong>
        · <%= upload.totalSkus %> SKU(s) · <%= upload.totalLinhas %> linha(s)
        <% if (upload.emissao) { %> · emissão ERP: <%= upload.emissao %><% } %>
        · enviada em <%= dtBR(upload.uploadedAt) %>
      </div>
      <div class="d-flex gap-2">
        <a href="/telas/estoque-full/relatorio" class="btn btn-success">
          <i class="bi bi-file-earmark-excel"></i> Baixar relatório Excel
        </a>
        <form method="post" action="/telas/estoque-full/limpar"
              onsubmit="return confirm('Apagar os dados da planilha enviada? O relatório deixará de estar disponível até você subir outra.');">
          <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Apagar dados
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Estatísticas -->
  <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    <div class="col"><div class="card kpi shadow-sm h-100"><div class="card-body d-flex align-items-start gap-2">
      <div class="kpi-icon text-bg-dark"><i class="bi bi-plus-square"></i></div>
      <div class="kpi-text"><div class="kpi-label">Não cadastrados</div><div class="kpi-value <%= cross.stats.naoCadastrados>0?'text-dark':'' %>"><%= cross.stats.naoCadastrados %></div><small class="text-muted">com estoque, sem anúncio</small></div>
    </div></div></div>
    <div class="col"><div class="card kpi shadow-sm h-100"><div class="card-body d-flex align-items-start gap-2">
      <div class="kpi-icon text-bg-danger"><i class="bi bi-box-seam"></i></div>
      <div class="kpi-text"><div class="kpi-label">103 baixo</div><div class="kpi-value <%= cross.stats.baixo103>0?'text-danger':'' %>"><%= cross.stats.baixo103 %></div><small class="text-muted">≤ <%= cross.limiar103 %> no SITE MATRIZ</small></div>
    </div></div></div>
    <div class="col"><div class="card kpi shadow-sm h-100"><div class="card-body d-flex align-items-start gap-2">
      <div class="kpi-icon text-bg-warning"><i class="bi bi-truck"></i></div>
      <div class="kpi-text"><div class="kpi-label">103 baixo c/ alternativa</div><div class="kpi-value <%= cross.stats.baixo103ComAlternativa>0?'text-warning':'' %>"><%= cross.stats.baixo103ComAlternativa %></div><small class="text-muted">há estoque em outro local</small></div>
    </div></div></div>
    <div class="col"><div class="card kpi shadow-sm h-100"><div class="card-body d-flex align-items-start gap-2">
      <div class="kpi-icon text-bg-secondary"><i class="bi bi-x-circle"></i></div>
      <div class="kpi-text"><div class="kpi-label">Sem estoque</div><div class="kpi-value"><%= cross.stats.semEstoque %></div><small class="text-muted">cadastrados, zero em tudo</small></div>
    </div></div></div>
  </div>

  <!-- Preview -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
      <span><i class="bi bi-table"></i> Prévia do relatório</span>
      <span class="small text-muted">mostrando <%= Math.min(PREVIEW, cross.rows.length) %> de <%= cross.rows.length %> — a planilha tem tudo</span>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>SKU</th>
            <th>Produto / Título</th>
            <th class="text-center">Cat?</th>
            <th class="text-center">Full?</th>
            <th class="text-end">Est. ML</th>
            <th class="text-end">Est. Full</th>
            <th>Status</th>
            <th class="text-center">No ML?</th>
            <% cross.locais.forEach(function(l){ %>
              <th class="text-end <%= l.marketplace ? 'table-warning' : '' %>" title="<%= l.cod %> - <%= l.nome %>"><%= l.cod %></th>
            <% }); %>
            <th>Sugestão</th>
          </tr>
        </thead>
        <tbody>
          <% cross.rows.slice(0, PREVIEW).forEach(function(r){ %>
            <tr>
              <td><strong><%= r.sku %></strong></td>
              <td class="text-truncate" style="max-width: 300px;" title="<%= r.titulo || r.produtoErp %>">
                <%= r.titulo || r.produtoErp %>
                <% if (!r.cadastrado) { %><span class="badge text-bg-dark ms-1">novo</span><% } %>
              </td>
              <td class="text-center"><%- boolBadge(r.temCatalogo) %></td>
              <td class="text-center"><%- boolBadge(r.estaNoFull) %></td>
              <td class="text-end"><%= r.estoque == null ? '—' : r.estoque %></td>
              <td class="text-end"><%= r.estoqueFull %></td>
              <td><%= r.status || '—' %></td>
              <td class="text-center">
                <% if (r.cadastrado) { %><i class="bi bi-check-circle-fill text-success"></i><% } else { %><i class="bi bi-dash-circle text-muted"></i><% } %>
              </td>
              <% cross.locais.forEach(function(l){ var v = r['est'+l.cod];
                   var baixo = l.marketplace && r.cadastrado && v <= cross.limiar103; %>
                <td class="text-end <%= l.marketplace ? 'table-warning' : '' %> <%= baixo ? 'text-danger fw-bold' : '' %>"><%= v %></td>
              <% }); %>
              <td><%- sugBadge(r.sugestao) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white text-muted small">
      Coluna destacada <span class="badge table-warning text-dark border">103</span> = SITE MATRIZ (marketplace).
      Locais: <% cross.locais.forEach(function(l,i){ %><%= l.cod %>–<%= l.nome %><%= i < cross.locais.length-1 ? ' · ' : '' %><% }); %> · Estoque Full = <%= cross.fullNome %>.
    </div>
  </div>

  <% } %>
</div>

<%- include('partials/footer') %>
